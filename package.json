{
  "name": "framengine",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev:api --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:server": "npm run build:server --workspace=backend",
    "start": "npm run start --workspace=backend",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test e2e/visual.spec.ts e2e/checkout-visual.spec.ts --update-snapshots",
    "db:seed": "npm run db:seed --workspace=backend",
    "admin:create": "npm run admin:create --workspace=backend",
    "order:package": "npm run order:package --workspace=backend",
    "preview": "npm run preview --workspace=frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
