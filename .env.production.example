# The shape of a PRODUCTION configuration. Set these as real environment
# variables on your host (or in a .env that lives only on the server).
# Every value below is a placeholder — none of them are real.

FRAMENGINE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://frames.example.com
DATABASE_URL=file:/var/lib/framengine/framengine.db
UPLOADS_DIR=/var/lib/framengine/uploads
PACKAGES_DIR=/var/lib/framengine/packages

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

WHATSAPP_NUMBER=919999999999
