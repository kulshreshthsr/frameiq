# Copy to .env for local use. NEVER commit .env or put real secrets in this file.
# Real environment variables always override .env.

# development | test | production
FRAMENGINE_ENV=development

PORT=8787
HOST=127.0.0.1

# libsql / SQLite. A local file in development; in production, a path on a
# persistent disk (file:/var/lib/framengine/framengine.db) or a hosted libsql URL.
DATABASE_URL=file:./data/framengine.db

# Where uploaded photos and finished production packages are written.
UPLOADS_DIR=./data/uploads
PACKAGES_DIR=./data/packages

# The public https:// address of the site (required in production).
PUBLIC_BASE_URL=http://localhost:5173

# Serve the built website from this server (production sets ./dist by default).
# STATIC_DIR=./dist

# ---- Payments -------------------------------------------------------------
# sandbox  : simulated payments for development and tests. NO real money moves.
#            The server REFUSES to start in production with this setting.
# razorpay : real payments. Needs the three values below (use Razorpay TEST
#            keys until you have verified an end-to-end payment).
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=dev-sandbox-secret-not-for-production

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Optional ---------------------------------------------------------------
# Business WhatsApp number in international format (digits; + and spaces are ignored).
# WHATSAPP_NUMBER=

# Comma-separated browser origins allowed to call the API cross-origin (normally none).
# CORS_ORIGINS=

# Turn the built-in request limiter on/off (on by default outside tests).
# RATE_LIMIT=on
# MAX_UPLOAD_BYTES=47185920
